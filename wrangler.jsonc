// Cloudflare (Workers + static assets) settings for the Hostio websites.
{
  "name": "hostio-server",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // /privatnost serves privatnost.html, /usluge serves usluge/index.html (canonical URLs have no .html).
    "html_handling": "auto-trailing-slash",
    // The worker runs first so it can redirect www / workers.dev to hostio.ba; it then serves the file from ASSETS.
    "run_worker_first": true
  },
  // Free Cloudflare Workers AI (daily free allocation); used by /ai/kvar.
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
