// Cloudflare (Workers + static assets) settings for the Hostio websites.
{
  "name": "hostio-server",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // /privatnost serves privatnost.html, /usluge serves usluge/index.html (canonical URLs have no .html).
    "html_handling": "auto-trailing-slash",
    // Only these paths run code; every other file is served directly (free and unlimited).
    "run_worker_first": ["/api/*", "/status"]
  },
  "observability": { "enabled": true }
}
